#!/usr/bin/env python3
"""Draw the door demo's mouse cell-size chart: `bin/door_demo_chart.py`, run by its command name.

The code lives in the `.py` file because a test executes it, and pytest-testmon fails with an
INTERNALERROR on an executed file with no extension (it reads a file's type from its suffix).
"""

import runpy
from pathlib import Path

runpy.run_path(str(Path(__file__).with_name("door_demo_chart.py")), run_name="__main__")
