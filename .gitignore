# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Evaluation corpus — an external input with unresolved licensing; never commit it.
# Anchored, and matching the data file too: the corpus is a single JSONL file, so a
# directory pattern alone would not stop `git add -A` committing it.
/corpus/
bionumbers*.jsonl
*.corpus.jsonl
# The conventional places a corpus gets put, ignored by name rather than by trust.
# This branch pushes to a course remote as well as a private one, and a corpus that
# lands here would publish; the protection must not depend on remembering to read
# it in place. Add a directory here before putting data in it, not after.
/data/
/datasets/
/raw/
*.jsonl.gz

# Secrets — see CLAUDE.md, "Never commit secrets"
.env
.env.*
!.env.example
*.key

# Agent runtime state — regenerable, and session content should not be committed
checkpoints/
logs/
eval-results/

# Coverage output — regenerated by `pytest --cov`
.coverage
.coverage.*
htmlcov/
