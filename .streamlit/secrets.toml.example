# Copy to `secrets.toml` beside this file and fill in. That copy is gitignored;
# this one is tracked, and must never carry a real value.
#
# Streamlit reads `.streamlit/secrets.toml` relative to the app, and Community
# Cloud takes the same content pasted into the app's Secrets box.

# The usage-events and feedback store: Neon serverless Postgres.
#
# Three things about this URL that a copy from Neon's console will get wrong:
#
#   1. The scheme must be `postgresql+psycopg://`. Neon hands you `postgresql://`,
#      and SQLAlchemy reaches for psycopg2 unless the driver is named -- psycopg2
#      is not a dependency here.
#   2. The host must contain `-pooler`. The direct endpoint is for long-lived
#      connections; a Streamlit rerun is the opposite of that, and the direct one
#      caps out at ~100 connections.
#   3. Percent-encode the password if it contains @ : / # or ?. Unencoded, the URI
#      splits at the wrong place and libpq reports an unresolvable host -- which
#      reads like DNS and is quoting.
[connections.usage]
url = "postgresql+psycopg://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Google OIDC, for `st.login`. Not yet used -- the auth work is a later change.
# `redirect_uri` must be absolute, and must match what is registered in the
# Google Cloud console exactly, including the scheme.
#
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"
# cookie_secret = "a long random string"
# client_id = "....apps.googleusercontent.com"
# client_secret = "..."
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Who may use the app, and as what. Presence in this table IS authorization;
# absence is refusal. One table, so an allowlist and a role map cannot drift.
# Not yet used -- the auth work is a later change.
#
# [roles]
# "someone@example.com" = "admin"
