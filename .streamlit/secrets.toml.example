# Copy to `secrets.toml` beside this file and fill in. That copy is gitignored;
# this one is tracked, and must never carry a real value.
#
# Streamlit reads `.streamlit/secrets.toml` relative to the app, and Community
# Cloud takes the same content pasted into the app's Secrets box.
#
# Top-level keys here are also set as environment variables before the app runs,
# which is how the settings in README's configuration table reach a deployment
# that has no shell of its own. The credential belongs here; the rest are
# optional overrides of the defaults.

OPENROUTER_API_KEY = "sk-or-..."
# SCINUMBERS_MODEL = "anthropic/claude-opus-4.7"
# SCINUMBERS_RUN_BUDGET_USD = "1.20"

# The usage-events and feedback store: Neon serverless Postgres.
#
# **Exactly one url, and it is the branch this checkout writes to.** One Neon
# project, one branch per environment -- `dev` for a laptop, `alpha` for the
# deployed app's testers, `production` reserved for real users and kept empty
# until there are some. See `docs/roadmap.md` for which branch is for what.
#
# Do not keep a second branch's url here as a spare. The url carries the
# password, so a spare is production credentials sitting on a development
# machine, and the whole reason for separate branches is that a dev row counted
# as real feedback corrupts the one dataset that cannot be recomputed. One entry
# means there is no ambiguity about where a write lands and no line to uncomment
# by accident.
#
# The hosts are not secret and are worth keeping to hand -- put them in a comment
# in your own uncommitted copy, not here, since this file is tracked. The
# passwords stay in Neon's console and in Community Cloud's Secrets box, which
# are also where they can always be fetched again.
#
# Three things about this URL that a copy from Neon's console will get wrong:
#
#   1. The scheme must be `postgresql+psycopg://`. Neon hands you `postgresql://`,
#      and SQLAlchemy reaches for psycopg2 unless the driver is named -- psycopg2
#      is not a dependency here.
#   2. The host must contain `-pooler`. The direct endpoint is for long-lived
#      connections; a Streamlit rerun is the opposite of that, and the direct one
#      caps out at ~100 connections.
#   3. Percent-encode the password if it contains @ : / # or ?. Unencoded, the URI
#      splits at the wrong place and libpq reports an unresolvable host -- which
#      reads like DNS and is quoting.
[connections.usage]
url = "postgresql+psycopg://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Google OIDC, for `st.login`. **Presence of this section is what turns sign-in
# on.** Without it the app runs as it did before identity existed: no sign-in,
# one credential from the environment, records carrying no account. With it,
# every visitor must sign in and be enrolled (see below) before anything is drawn.
#
# `redirect_uri` must be absolute, must end in `/oauth2callback`, and must match
# what is registered in the Google Cloud console exactly, including the scheme.
# `cookie_secret` is any long random string; it signs the identity cookie.
# Streamlit turns on CORS and XSRF protection itself when this section exists.
# Verified against the installed Streamlit 1.61.1 on 2026-09-16.
#
# `{port}` is substituted with `server.port` at runtime (read from the installed
# Streamlit 1.61.1, `auth_util.get_redirect_uri`), so this cannot drift from the
# port the app is actually served on -- which matters the moment a second app on
# the same machine takes 8501. **The identity provider still needs the concrete
# URL** in its allowed-callbacks list, one entry per port you develop on; the
# placeholder helps this side only.
#
# [auth]
# redirect_uri = "http://localhost:{port}/oauth2callback"
# cookie_secret = "a long random string"
# client_id = "....apps.googleusercontent.com"
# client_secret = "..."
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# **Everything above belongs to `[auth]` itself and must stay above the sub-table.**
# This is TOML, not Streamlit: after the `[auth.auth0]` header every bare key
# belongs to that sub-table until the next header, so a `redirect_uri` written
# below it silently becomes `auth.auth0.redirect_uri`. `[auth]` then has none, and
# sign-in fails for *every* provider -- the shared settings are shared.
#
# A second provider, so an address that is not a Google account can sign in.
# **A sub-table is a named provider**; the credentials directly under `[auth]`
# above are the unnamed default. The page draws one button per provider it finds
# and calls `st.login("auth0")` for this one -- `st.login("default")` is not a
# synonym for the unnamed form, which is why the two are kept apart.
#
# Any OIDC provider works; this deployment uses Auth0. The tenant needs a Regular
# Web Application whose allowed callback URL is this app's `/oauth2callback`, and
# a database connection with sign-up open and **email verification required**.
#
# Verification is not taken on trust: the app admits an address only where the
# provider's `email_verified` claim says so, and refuses when the claim is absent
# (ADR-0890). With sign-up open that is the only thing standing between an
# enrolled tester and anyone who registers their address.
#
# Adding a provider here is the whole change -- no redeploy of anything else, and
# a name with no label of its own gets a plain "Sign in with <name>" button.
#
# [auth.auth0]
# client_id = "..."
# client_secret = "..."
# server_metadata_url = "https://YOUR-TENANT.eu.auth0.com/.well-known/openid-configuration"

# Who may use the app, and as what, is NOT in this file. Enrolment is a row in the
# `accounts` table of the same database as `[connections.usage]` -- see
# `sql/accounts.sql` -- so that a tester can be added, given a role and issued a
# credential without a redeploy. Signed in but not enrolled is refused.
#
# The row is written by `scinumbers-enrol`, which mints the capped key and inserts
# it in one step. **It does not read this file**, deliberately: the one url here is
# the branch *this checkout* writes to, which on a laptop is `dev`, and enrolling a
# tester into `dev` is the silent wrong write this file's one-url rule exists to
# prevent -- the deployed app looks them up in `alpha`, says "not enrolled", and
# the operator finds the row in the table they can see. The command takes
# `--branch` with no default and resolves it through Neon's API, so no second url
# is ever written down. See README, "Sign-in and enrolment".
